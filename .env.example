# Non-secret config ONLY. Secrets live in the macOS Keychain (see pa_core/secrets.py).
# launchd passes an ABSOLUTE path to this file via PA_ENV_FILE, because a launchd job
# gets almost no environment -- no shell profile, no PATH, none of your exports.

PA_TZ=Asia/Ho_Chi_Minh

# LLM -- zero-cost path is the default. Pin FULL tags including quantization:
# `qwen3.5:9b` without a suffix can be re-pointed upstream and silently change your model.
#
# MEASURED: the 3B is NOT good enough for mail triage. On a 4-message eval set the 3B
# scored 3/4 with every `timing` wrong (it called a stated card-expiry date "none");
# the 7B scored 4/4 with correct timings and real verbatim quotes. The plan assumed
# "classify -> small model"; measurement overruled it. Both tiers run the 7B until
# there is an eval set big enough to justify anything cheaper.
PA_OLLAMA_URL=http://127.0.0.1:11434
PA_MODEL_SMALL=qwen2.5:7b-instruct-q4_K_M
PA_MODEL_LARGE=qwen2.5:7b-instruct-q4_K_M
PA_MODEL_EMBED=bge-m3

# The nominal 256K context is a lie at 16 GB: the KV cache is the binding constraint.
# This is why the morning brief MUST be map-reduce, not one big call.
PA_NUM_CTX=8192

# Master switch for ANY non-local backend. Off by default.
PA_ALLOW_CLOUD=false
PA_MONTHLY_BUDGET_USD=5.0

PA_SINKS=["file","telegram","notify"]
