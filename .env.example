# Non-secret configuration. The Telegram token lives in macOS Keychain.
# launchd passes an absolute path to this file through PA_ENV_FILE.

PA_TZ=Asia/Ho_Chi_Minh
PA_OLLAMA_URL=http://127.0.0.1:11434

# Pin the full model tag so inference uses the intended quantization.
PA_MODEL_SMALL=qwen2.5:7b-instruct-q4_K_M
PA_MODEL_LARGE=qwen2.5:7b-instruct-q4_K_M

# Bound context memory. Longer source text is summarized in small batches.
PA_NUM_CTX=8192

# Always archive locally before Telegram delivery.
PA_SINKS=["file","telegram"]
