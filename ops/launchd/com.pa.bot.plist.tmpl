<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pa.bot</string>

  <!-- The inbound side of the Telegram chat: reply-to-save and /search. Long-polls
       getUpdates, so it must always be running. Runs the DEPLOYED runtime, never the
       repo (macOS TCC denies launchd access to ~/Documents). -->
  <key>ProgramArguments</key>
  <array>
    <string>@@RUNTIME@@/run.sh</string>
    <string>bot</string>
    <string>@@RUNTIME@@/venv/bin/pa-bot</string>
  </array>

  <!-- Always on. If it exits (crash, network gone at boot), launchd restarts it, but no
       more often than every 10s so a hard failure cannot spin the CPU. -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>

  <key>WorkingDirectory</key><string>@@RUNTIME@@</string>
  <key>StandardOutPath</key><string>@@HOME@@/Library/Logs/pet-agents/bot.out.log</string>
  <key>StandardErrorPath</key><string>@@HOME@@/Library/Logs/pet-agents/bot.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@@HOME@@</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PA_ENV_FILE</key><string>@@RUNTIME@@/.env</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>

  <!-- Interactive replies, so not Background: a /search should not be deprioritised
       while you wait for it. -->
  <key>ProcessType</key><string>Standard</string>
  <key>ExitTimeOut</key><integer>20</integer>
</dict>
</plist>
